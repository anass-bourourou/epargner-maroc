---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import NewsletterPopup from '../components/marketing/NewsletterPopup.astro';
import {
  organizationSchema,
  websiteSchema,
} from '../lib/seo';

type OgType = 'website' | 'article';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: OgType;
  publishedTime?: Date;
  modifiedTime?: Date;
  articleTags?: string[];
  noindex?: boolean;
  hideChrome?: boolean;
}

const {
  title,
  description = 'Épargner Maroc — conseils, outils et comparatifs pour mieux gérer son argent au Maroc.',
  canonical,
  ogImage,
  ogType = 'website' as OgType,
  publishedTime,
  modifiedTime,
  articleTags = [],
  noindex = false,
  hideChrome = false,
} = Astro.props as Props;

const site = Astro.site?.toString() ?? 'https://epargner-maroc.com';
const siteBase = site.replace(/\/$/, '');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
// Avoid duplicating the brand — some callers include "Épargner Maroc" up front
// (the homepage: "Épargner Maroc — Mieux gérer son argent au Maroc"),
// others rely on the suffix. Never emit "Foo — Épargner Maroc — Épargner Maroc".
const NORMALIZED = title.trim();
const alreadyBranded = /Épargner Maroc/i.test(NORMALIZED);
const fullTitle = alreadyBranded ? NORMALIZED : `${NORMALIZED} — Épargner Maroc`;

// Default social share image — self-hosted, editorial, brand-consistent.
const socialImage = ogImage ?? `${siteBase}/og/default.svg`;

// Sitewide schemas emitted once per page.
const orgLd = organizationSchema(site);
const siteLd = websiteSchema(site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbf8f2" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Preload self-hosted fonts (critical subsets) -->
    <link
      rel="preload"
      href="/fonts/playfair-display-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Épargner Maroc" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_MA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Épargner Maroc" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {ogType === 'article' && articleTags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Icons + manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Language alternates (single locale today; Arabic planned) -->
    <link rel="alternate" hreflang="fr-MA" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Épargner Maroc"
      href={new URL('rss.xml', site).toString()}
    />

    <!-- Sitewide structured data (Organization + WebSite) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-[color:var(--color-primary)] focus:text-[color:var(--color-primary-foreground)] focus:px-3 focus:py-2 focus:rounded-[var(--radius-sm)]"
    >
      Aller au contenu
    </a>

    {!hideChrome && <Header />}

    <main id="main" class="flex-1">
      <slot />
    </main>

    {!hideChrome && <Footer />}

    {!hideChrome && <NewsletterPopup />}
  </body>
</html>
