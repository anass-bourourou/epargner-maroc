---
interface Props {
  cite?: string;
  source?: string;
  class?: string;
}
const { cite, source, class: className = '' } = Astro.props as Props;
---

<figure class={`my-10 max-w-[60ch] ${className}`}>
  <blockquote class="border-l-2 border-[color:var(--color-primary)] pl-6 font-[var(--font-display)] italic text-[1.375rem] leading-[1.4] text-[color:var(--color-foreground-strong)]">
    <slot />
  </blockquote>
  {(cite || source) && (
    <figcaption class="mt-3 pl-6 text-[0.8125rem] text-[color:var(--color-foreground-muted)]">
      {cite && <span>{cite}</span>}
      {cite && source && <span aria-hidden="true"> · </span>}
      {source && <cite class="not-italic">{source}</cite>}
    </figcaption>
  )}
</figure>
