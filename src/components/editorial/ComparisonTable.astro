---
// Reusable comparison table. Data-driven to keep MDX callsites clean.
// Marked as illustrative when appropriate — never fabricate real product data.

interface Row {
  label: string;
  values: (string | number)[];
  emphasis?: boolean;
}

interface Props {
  caption?: string;
  columns: string[];
  rows: Row[];
  note?: string;
  updated?: string; // human-readable, e.g. "Août 2026"
  class?: string;
}

const {
  caption,
  columns,
  rows,
  note,
  updated,
  class: className = '',
} = Astro.props as Props;
---

<figure
  class={`my-10 border border-[color:var(--color-border)] overflow-x-auto rounded-[var(--radius-sm)] ${className}`}
>
  {(caption || updated) && (
    <figcaption class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[color:var(--color-border)] bg-[color:var(--color-surface-muted)] px-5 py-3 text-[0.8125rem]">
      {caption && <span class="font-medium text-[color:var(--color-foreground-strong)]">{caption}</span>}
      {updated && <span class="text-[color:var(--color-foreground-muted)]">Mis à jour · {updated}</span>}
    </figcaption>
  )}
  <table class="w-full border-collapse text-[0.9375rem]">
    <thead>
      <tr class="border-b border-[color:var(--color-border-strong)]">
        {columns.map((c) => (
          <th
            scope="col"
            class="px-4 py-3 text-left font-[var(--font-sans)] font-semibold text-[0.8125rem] uppercase tracking-[0.1em] text-[color:var(--color-foreground-strong)]"
          >
            {c}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr class="border-b border-[color:var(--color-border)] last:border-b-0">
          <th
            scope="row"
            class="px-4 py-3 text-left font-medium text-[color:var(--color-foreground-strong)]"
          >
            {r.label}
          </th>
          {r.values.map((v) => (
            <td
              class:list={[
                'px-4 py-3 num',
                r.emphasis
                  ? 'font-medium text-[color:var(--color-foreground-strong)]'
                  : 'text-[color:var(--color-foreground)]',
              ]}
            >
              {v}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
  {note && (
    <p class="border-t border-[color:var(--color-border)] px-5 py-3 text-[0.75rem] text-[color:var(--color-foreground-muted)]">
      {note}
    </p>
  )}
</figure>
