---
import EditorialLabel from '../ui/EditorialLabel.astro';
import Icon from '../ui/Icon.astro';
import type { Guide } from '../../lib/articles';
import { categoryMeta } from '../../lib/categories';
import { guideHref } from '../../lib/articles';
import { formatDateLong } from '../../lib/formatters/date';

interface Props {
  guide: Guide;
  variant?: 'default' | 'compact';
}

const { guide, variant = 'default' } = Astro.props as Props;
const href = guideHref(guide);
const cat = categoryMeta(guide.data.category);
---

{
  variant === 'default' && (
    <article class="group border-t border-[color:var(--color-border-strong)] pt-5">
      <EditorialLabel href={cat.href} class="mb-3">{cat.label}</EditorialLabel>
      <h3 class="text-[1.375rem] leading-snug">
        <a
          href={href}
          class="no-underline decoration-transparent transition-colors hover:text-[color:var(--color-primary)]"
        >
          {guide.data.title}
        </a>
      </h3>
      <p class="mt-3 text-[0.9375rem] leading-relaxed text-[color:var(--color-foreground-muted)]">
        {guide.data.description}
      </p>
      <div class="mt-5 flex items-center justify-between gap-3 text-[0.8125rem]">
        <a
          href={href}
          class="inline-flex items-center gap-2 font-medium text-[color:var(--color-primary)] no-underline"
        >
          Lire le guide <Icon name="arrow-right" size={14} />
        </a>
        <time class="text-[color:var(--color-foreground-subtle)]" datetime={guide.data.publishedAt.toISOString()}>
          {formatDateLong(guide.data.publishedAt)}
        </time>
      </div>
    </article>
  )
}

{
  variant === 'compact' && (
    <a
      href={href}
      class="group flex items-baseline gap-4 border-b border-[color:var(--color-border)] py-4 no-underline last:border-b-0"
    >
      <span class="w-16 shrink-0 text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[color:var(--color-primary)]">
        {cat.label}
      </span>
      <span class="flex-1 font-[var(--font-display)] text-[1.0625rem] leading-snug text-[color:var(--color-foreground-strong)] group-hover:text-[color:var(--color-primary)]">
        {guide.data.title}
      </span>
      <Icon name="arrow-right" size={14} />
    </a>
  )
}
