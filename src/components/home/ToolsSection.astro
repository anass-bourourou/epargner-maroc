---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';

interface Tool {
  index: string;
  label: string;
  title: string;
  description: string;
  href: string;
  icon: IconName;
}

const tools: Tool[] = [
  {
    index: '01',
    label: 'Épargne',
    title: "Calculateur d'épargne",
    description:
      "Estimer combien peut peser une épargne mensuelle après quelques années, selon un versement et un rendement.",
    href: '/outils/calculateur-epargne/',
    icon: 'calculator',
  },
  {
    index: '02',
    label: 'Budget',
    title: 'Budget mensuel',
    description:
      "Répartir revenus et dépenses par grand poste, calculer un reste à vivre, mesurer un taux d'épargne.",
    href: '/outils/budget/',
    icon: 'calculator',
  },
  {
    index: '03',
    label: 'Crédit',
    title: 'Calculateur de crédit',
    description:
      "Simuler une mensualité, un coût total et une part d'intérêts pour un crédit consommation ou immobilier.",
    href: '/outils/calculateur-credit/',
    icon: 'calculator',
  },
];
---

<section class="border-b border-[color:var(--color-border)]">
  <div class="container-wide section-py">
    <SectionHeading
      eyebrow="Outils"
      title="Des outils pour décider plus clairement."
      description="Trois calculateurs simples pour transformer une intuition en chiffres — à partir de votre propre situation."
    >
      <Button slot="action" as="a" href="/outils/" variant="text" iconRight="arrow-right">
        Tous les outils
      </Button>
    </SectionHeading>

    <div class="mt-12 grid gap-px border border-[color:var(--color-border)] bg-[color:var(--color-border)] sm:grid-cols-3">
      {tools.map((t) => (
        <a
          href={t.href}
          class="group flex flex-col bg-[color:var(--color-surface)] p-6 sm:p-8 no-underline transition-colors hover:bg-[color:var(--color-surface-muted)]/70"
        >
          <div class="flex items-center justify-between">
            <span class="font-[var(--font-display)] text-[color:var(--color-foreground-subtle)] text-[1.375rem] num">
              {t.index}
            </span>
            <span class="text-[color:var(--color-primary)] transition-transform group-hover:translate-x-1">
              <Icon name="arrow-up-right" size={18} />
            </span>
          </div>
          <p class="overline mt-6">{t.label}</p>
          <h3 class="mt-3 text-[1.375rem] leading-[1.2]">{t.title}</h3>
          <p class="mt-4 grow text-[0.9375rem] leading-relaxed text-[color:var(--color-foreground-muted)]">
            {t.description}
          </p>
          <span class="mt-6 inline-flex items-center gap-2 text-[0.875rem] font-medium text-[color:var(--color-primary)]">
            Ouvrir le calculateur
            <Icon name="arrow-right" size={14} />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
