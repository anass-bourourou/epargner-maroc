---
import SectionHeading from '../ui/SectionHeading.astro';
import ArticleCard from '../articles/ArticleCard.astro';
import Button from '../ui/Button.astro';
import Divider from '../ui/Divider.astro';
import { getFeaturedArticles, articleHref, type Article } from '../../lib/articles';
import { formatDateLong, formatDateShort } from '../../lib/formatters/date';

const CATEGORY_LABEL: Record<string, string> = {
  epargne: 'Épargne',
  banques: 'Banques',
  assurances: 'Assurances',
  credit: 'Crédit',
  investissement: 'Investissement',
  guides: 'Guide',
  outils: 'Outil',
};

const CATEGORY_HREF: Record<string, string> = {
  epargne: '/epargne/',
  banques: '/banques/',
  assurances: '/assurances/',
  credit: '/credit/',
  investissement: '/investissement/',
  guides: '/guides/',
  outils: '/outils/',
};

const featured = (await getFeaturedArticles(4)) as Article[];
const [lead, ...rest] = featured;
---

{
  lead && (
    <section class="border-b border-[color:var(--color-border)]">
      <div class="container-wide section-py">
        <SectionHeading
          eyebrow="À la une"
          title="Ce qu'il faut lire cette semaine."
          description="Une sélection éditoriale hebdomadaire, choisie pour son utilité pratique — pas pour son actualité."
        />

        <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-16">
          <!-- Lead article -->
          <article class="lg:col-span-7">
            <a
              href={articleHref(lead)}
              class="overline no-underline hover:text-[color:var(--color-primary-hover)]"
            >
              {CATEGORY_LABEL[lead.data.category]}
            </a>
            <h3 class="mt-4 text-[clamp(1.75rem,3.5vw,2.75rem)] leading-[1.05] tracking-[-0.01em]">
              <a
                href={articleHref(lead)}
                class="no-underline decoration-transparent transition-colors hover:text-[color:var(--color-primary)]"
              >
                {lead.data.title}
              </a>
            </h3>
            <p class="mt-5 max-w-[56ch] text-[1.0625rem] leading-relaxed text-[color:var(--color-foreground-muted)]">
              {lead.data.description}
            </p>
            <div class="mt-6 flex items-center gap-3 text-[0.8125rem] text-[color:var(--color-foreground-subtle)]">
              <time datetime={lead.data.publishedAt.toISOString()}>
                {formatDateLong(lead.data.publishedAt)}
              </time>
              {lead.data.readingTime && (
                <><span aria-hidden="true">·</span><span>{lead.data.readingTime} min</span></>
              )}
            </div>
          </article>

          <!-- Secondary compact list -->
          <aside class="lg:col-span-5 lg:border-l lg:border-[color:var(--color-border)] lg:pl-10">
            <p class="overline mb-4">Aussi cette semaine</p>
            <ul class="flex flex-col">
              {rest.map((a) => (
                <li>
                  <ArticleCard
                    variant="compact"
                    href={articleHref(a)}
                    category={CATEGORY_LABEL[a.data.category]}
                    categoryHref={CATEGORY_HREF[a.data.category]}
                    title={a.data.title}
                    date={formatDateShort(a.data.publishedAt)}
                    readingMinutes={a.data.readingTime}
                  />
                </li>
              ))}
            </ul>
            <div class="mt-6">
              <Button as="a" href="/articles/" variant="text" iconRight="arrow-right">
                Tous les articles
              </Button>
            </div>
          </aside>
        </div>
        <Divider class="mt-16" />
      </div>
    </section>
  )
}
