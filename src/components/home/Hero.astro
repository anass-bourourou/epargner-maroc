---
import Button from '../ui/Button.astro';
import EditorialLabel from '../ui/EditorialLabel.astro';
import HeroChart from './HeroChart.astro';
---

<section class="border-b border-[color:var(--color-border)]">
  <div class="container-wide pt-16 pb-20 md:pt-20 md:pb-24 lg:pt-28 lg:pb-32">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Editorial column -->
      <div class="lg:col-span-7 lg:pt-4">
        <EditorialLabel class="mb-6">Épargner Maroc</EditorialLabel>
        <h1
          class="max-w-[14ch] text-[clamp(2.5rem,6vw,4.75rem)] leading-[1.02] tracking-[-0.02em]"
        >
          Mieux gérer<br />son argent au Maroc.
        </h1>
        <p
          class="mt-7 max-w-[52ch] text-[1.125rem] leading-relaxed text-[color:var(--color-foreground-muted)]"
        >
          Conseils, outils et comparatifs pour prendre de meilleures décisions
          financières. Une publication indépendante, en français, pensée pour
          le contexte marocain.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button as="a" href="/outils/" variant="primary" size="lg" iconRight="arrow-right">
            Explorer les outils
          </Button>
          <Button as="a" href="/guides/" variant="text">
            Lire les guides
          </Button>
        </div>
      </div>

      <!-- Visualization column -->
      <div
        class="lg:col-span-5 lg:pl-6 lg:border-l lg:border-[color:var(--color-border)]"
      >
        <HeroChart />
      </div>
    </div>
  </div>
</section>
