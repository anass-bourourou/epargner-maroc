---
import EditorialLabel from '../ui/EditorialLabel.astro';

// -----------------------------------------------------------------------------
// Newsletter form — MailerLite integration (v4, fix about:blank).
//
// Le formulaire soumet dans une iframe cachée (target="ml-target") au lieu
// de "_blank" — ainsi aucun onglet vide ne s'ouvre lorsqu'un visiteur clique
// sur "Je m'inscris". Le script officiel MailerLite est toujours chargé et
// tentera d'intercepter la soumission (AJAX + callback succès) ; s'il échoue
// à s'attacher, la soumission normale du navigateur vers l'iframe cachée
// prend le relais et notre JS bascule vers le message de succès.
//
// Account: 2629612 · Form: 198312522838705786 · Form UI ID: 45824205
// -----------------------------------------------------------------------------

const ML_FORM_ID = '45824205';
const ML_FORM_ACTION =
  'https://assets.mailerlite.com/jsonp/2629612/forms/198312522838705786/subscribe';
const ML_TAKEL_URL =
  'https://assets.mailerlite.com/jsonp/2629612/forms/198312522838705786/takel';
---

<section
  class="border-b border-[color:var(--color-border)] bg-[color:var(--color-forest-900)] text-[color:var(--color-ivory-50)]"
>
  <div class="container-wide py-20 md:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        <EditorialLabel tone="muted" class="mb-5 !text-[color:var(--color-sage-300)]">
          Newsletter
        </EditorialLabel>
        <h2
          class="max-w-[18ch] text-[color:var(--color-ivory-50)] text-[clamp(2rem,3.5vw,3rem)] leading-[1.08]"
        >
          Les bonnes informations financières,<br />sans le bruit.
        </h2>
        <p
          class="mt-5 max-w-[56ch] text-[1.0625rem] leading-relaxed text-[color:var(--color-sage-300)]"
        >
          Un e-mail par semaine — une lecture recommandée, un outil utile,
          un chiffre à retenir. Rien de plus. Désinscription en un clic.
        </p>
      </div>

      <div class="lg:col-span-5">
        <!--
          Iframe cachée qui reçoit la réponse de MailerLite si la soumission
          navigateur classique se déclenche (au lieu d'ouvrir "_blank").
          Positionnée en dehors de l'écran, sans dimensions visibles.
        -->
        <iframe
          name="ml-target"
          title="MailerLite submission target"
          aria-hidden="true"
          tabindex="-1"
          style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;border:0;visibility:hidden"
        ></iframe>

        <!--
          Structure MailerLite : leur script cherche .ml-subscribe-form-{ID},
          .ml-block-form, .row-form, .row-success, .ml-form-fieldRow.
        -->
        <div
          id={`mlb2-${ML_FORM_ID}`}
          class:list={[
            'ml-form-embedContainer',
            'ml-subscribe-form',
            `ml-subscribe-form-${ML_FORM_ID}`,
            'em-newsletter',
          ]}
        >
          <div class="ml-form-embedWrapper">
            <div class="ml-form-embedBody row-form">
              <form
                id="newsletter-form"
                class="ml-block-form em-form"
                action={ML_FORM_ACTION}
                method="post"
                target="ml-target"
                data-code=""
                aria-describedby="newsletter-note"
              >
                <div class="ml-form-formContent">
                  <div class="ml-form-fieldRow ml-last-item em-field-row">
                    <div class="ml-field-group ml-field-email ml-validate-email ml-validate-required em-field-group">
                      <label for="newsletter-email" class="em-label">
                        Votre e-mail <span aria-hidden="true" class="em-required">*</span>
                      </label>
                      <input
                        id="newsletter-email"
                        aria-label="email"
                        aria-required="true"
                        type="email"
                        class="form-control em-input"
                        name="fields[email]"
                        placeholder="vous@exemple.ma"
                        autocomplete="email"
                        required
                      />
                    </div>
                  </div>
                </div>

                <input type="hidden" name="ml-submit" value="1" />
                <input type="hidden" name="anticsrf" value="true" />

                <div class="ml-form-embedSubmit em-submit-row">
                  <button type="submit" class="primary em-submit">
                    Je m'inscris <span aria-hidden="true" class="em-arrow">→</span>
                  </button>
                  <button
                    disabled
                    style="display:none"
                    type="button"
                    class="loading em-submit em-loading"
                  >
                    <span class="em-spinner" aria-hidden="true"></span>
                    <span>Envoi…</span>
                  </button>
                </div>
              </form>

              <p id="newsletter-note" class="em-note">
                En vous inscrivant, vous acceptez de recevoir la newsletter d'Épargner
                Maroc. Vos données ne sont ni revendues ni partagées.
              </p>
            </div>

            <div class="ml-form-successBody row-success" style="display:none">
              <div class="em-success">
                <p class="em-success-title">✅ Merci — inscription confirmée.</p>
                <p class="em-success-text">
                  Vous recevrez notre prochaine lettre vendredi. Vérifiez vos spams
                  si vous ne trouvez pas notre email de bienvenue.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .em-newsletter,
  .em-newsletter * {
    box-sizing: border-box;
  }

  .em-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }
  @media (min-width: 640px) {
    .em-form {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .em-field-row {
    margin: 0 !important;
    flex: 1;
  }
  .em-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    text-align: left;
  }
  .em-label {
    color: var(--color-ivory-50);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
  }
  .em-required {
    color: var(--color-terracotta-700);
  }
  .em-input {
    width: 100%;
    height: 2.75rem;
    padding: 0 0.75rem;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-ivory-50);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    line-height: 1.5;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .em-input::placeholder {
    color: var(--color-sage-500);
  }
  .em-input:focus {
    outline: none;
    border-color: var(--color-sage-300);
    box-shadow: 0 0 0 3px rgba(193, 207, 196, 0.18);
  }

  .em-submit-row {
    margin: 0 !important;
    display: flex;
    align-items: flex-end;
  }
  .em-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 1.25rem;
    background: var(--color-forest-500);
    color: var(--color-ivory-50);
    border: 1px solid var(--color-forest-500);
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
    white-space: nowrap;
  }
  .em-submit:hover {
    background: var(--color-forest-700, #143128);
    border-color: var(--color-forest-700, #143128);
  }
  .em-submit:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(193, 207, 196, 0.18);
  }
  .em-arrow {
    display: inline-block;
    transform: translateY(-1px);
  }

  .em-loading {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.1);
    cursor: wait;
  }
  .em-spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: var(--color-ivory-50);
    border-radius: 50%;
    animation: em-spin 0.8s linear infinite;
  }
  @keyframes em-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .em-note {
    margin: 1rem 0 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-sage-500);
  }

  .em-success {
    padding: 1.25rem;
    background: rgba(193, 207, 196, 0.1);
    border: 1px solid rgba(193, 207, 196, 0.3);
    border-radius: var(--radius-sm);
  }
  .em-success-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ivory-50);
  }
  .em-success-text {
    margin: 0.25rem 0 0 0;
    font-size: 0.875rem;
    color: var(--color-sage-300);
  }
</style>

<!-- Callback succès attendu par le script MailerLite (nom exact requis). -->
<script is:inline define:vars={{ ML_FORM_ID }}>
  window['ml_webform_success_' + ML_FORM_ID] = function () {
    var container = document.querySelector('.ml-subscribe-form-' + ML_FORM_ID);
    if (!container) return;
    var form = container.querySelector('.row-form');
    var success = container.querySelector('.row-success');
    if (form) form.style.display = 'none';
    if (success) success.style.display = 'block';
  };
</script>

<!-- Fallback JS : si MailerLite ne s'attache pas, on bascule quand même
     l'UI vers le message succès après la soumission (via iframe cachée). -->
<script is:inline>
  (function () {
    var form = document.getElementById('newsletter-form');
    if (!form) return;
    form.addEventListener('submit', function () {
      var submitButton = form.querySelector('button.primary');
      if (submitButton) submitButton.setAttribute('disabled', 'disabled');

      // Laisse 900 ms à MailerLite pour intercepter et prendre le contrôle.
      // Sinon on bascule nous-mêmes vers l'UI succès.
      window.setTimeout(function () {
        var container = document.querySelector('.ml-subscribe-form-45824205');
        if (!container) return;
        var successBox = container.querySelector('.row-success');
        // Ne bascule que si MailerLite n'a pas déjà changé l'affichage.
        if (successBox && successBox.style.display !== 'block') {
          var formBox = container.querySelector('.row-form');
          if (formBox) formBox.style.display = 'none';
          successBox.style.display = 'block';
        }
      }, 900);
    });
  })();
</script>

<!-- Script officiel MailerLite (tentera d'intercepter proprement) -->
<script
  is:inline
  src="https://groot.mailerlite.com/js/w/webforms.min.js?v83147fa8ce2d95cb73ece7f28b469519"
></script>

<!-- Initialisation session MailerLite -->
<script is:inline define:vars={{ ML_TAKEL_URL }}>
  try {
    fetch(ML_TAKEL_URL, { mode: 'no-cors' });
  } catch (e) {
    // silent
  }
</script>
