---
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import EditorialLabel from '../ui/EditorialLabel.astro';

// -----------------------------------------------------------------------------
// Newsletter form — Cloudflare Worker backend (v5, production).
//
// Le formulaire POST vers notre Worker Cloudflare qui appelle l'API
// MailerLite avec la clé secrète stockée en variable d'environnement.
// Worker : https://newsletter-epargner-maroc.anassbr01.workers.dev/
//
// Flow :
//   1. Utilisateur entre son email → clique "Je m'inscris"
//   2. JS intercepte le submit → fetch POST vers le Worker avec {email}
//   3. Worker valide + appelle MailerLite API → retourne {ok: true} ou {error}
//   4. UI bascule sur "✅ Merci" ou affiche le message d'erreur
// -----------------------------------------------------------------------------

const WORKER_URL =
  'https://newsletter-epargner-maroc.anassbr01.workers.dev/';
---

<section
  class="border-b border-[color:var(--color-border)] bg-[color:var(--color-forest-900)] text-[color:var(--color-ivory-50)]"
>
  <div class="container-wide py-20 md:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        <EditorialLabel tone="muted" class="mb-5 !text-[color:var(--color-sage-300)]">
          Newsletter
        </EditorialLabel>
        <h2
          class="max-w-[18ch] text-[color:var(--color-ivory-50)] text-[clamp(2rem,3.5vw,3rem)] leading-[1.08]"
        >
          Les bonnes informations financières,<br />sans le bruit.
        </h2>
        <p
          class="mt-5 max-w-[56ch] text-[1.0625rem] leading-relaxed text-[color:var(--color-sage-300)]"
        >
          Un e-mail par semaine — une lecture recommandée, un outil utile,
          un chiffre à retenir. Rien de plus. Désinscription en un clic.
        </p>
      </div>

      <div class="lg:col-span-5">
        <!-- Form (visible par défaut) -->
        <form
          id="newsletter-form"
          class="flex flex-col gap-4 sm:flex-row sm:items-end"
          aria-describedby="newsletter-note"
          novalidate
        >
          <div class="flex-1">
            <Input
              id="newsletter-email"
              name="email"
              label="Votre e-mail"
              type="email"
              placeholder="vous@exemple.ma"
              autocomplete="email"
              required
            />
          </div>
          <Button type="submit" size="lg" iconRight="arrow-right">
            Je m'inscris
          </Button>
        </form>

        <!-- Message de succès (caché par défaut) -->
        <div
          id="newsletter-success"
          hidden
          class="rounded-[var(--radius-sm)] border border-[color:var(--color-sage-300)]/30 bg-[color:var(--color-sage-300)]/10 p-5"
          role="status"
          aria-live="polite"
        >
          <p class="text-[1rem] font-medium text-[color:var(--color-ivory-50)]">
            ✅ Merci — inscription confirmée.
          </p>
          <p class="mt-1 text-[0.875rem] text-[color:var(--color-sage-300)]">
            Vous recevrez notre prochaine lettre vendredi. Vérifiez vos spams
            si vous ne trouvez pas notre email de bienvenue.
          </p>
        </div>

        <!-- Message d'erreur (caché par défaut) -->
        <div
          id="newsletter-error"
          hidden
          class="rounded-[var(--radius-sm)] border border-[color:var(--color-terracotta-700)]/40 bg-[color:var(--color-terracotta-700)]/10 p-4"
          role="alert"
        >
          <p
            id="newsletter-error-text"
            class="text-[0.9375rem] text-[color:var(--color-ivory-50)]"
          >
            Une erreur est survenue. Merci de réessayer dans un instant.
          </p>
        </div>

        <p
          id="newsletter-note"
          class="mt-4 text-[0.75rem] leading-relaxed text-[color:var(--color-sage-500)]"
        >
          En vous inscrivant, vous acceptez de recevoir la newsletter d'Épargner
          Maroc. Vos données ne sont ni revendues ni partagées.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Override input surface colors so the field reads correctly on the dark band. */
  section :global(label) {
    color: var(--color-ivory-50) !important;
  }
  section :global(input) {
    background: rgba(255, 255, 255, 0.06) !important;
    border-color: rgba(255, 255, 255, 0.18) !important;
    color: var(--color-ivory-50) !important;
  }
  section :global(input::placeholder) {
    color: var(--color-sage-500) !important;
  }
  section :global(input:focus) {
    border-color: var(--color-sage-300) !important;
    box-shadow: 0 0 0 3px rgba(193, 207, 196, 0.18) !important;
  }
</style>

<script is:inline define:vars={{ WORKER_URL }}>
  (function () {
    var form = document.getElementById('newsletter-form');
    var successBox = document.getElementById('newsletter-success');
    var errorBox = document.getElementById('newsletter-error');
    var errorText = document.getElementById('newsletter-error-text');

    if (!form || !successBox || !errorBox || !errorText) return;

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      var emailInput = form.querySelector('input[type="email"]');
      var email = emailInput ? String(emailInput.value || '').trim() : '';

      if (!email) {
        errorText.textContent = 'Veuillez saisir votre e-mail.';
        errorBox.hidden = false;
        return;
      }

      var submitButton = form.querySelector('button[type="submit"]');
      if (submitButton) submitButton.setAttribute('disabled', 'disabled');
      errorBox.hidden = true;

      fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email }),
      })
        .then(function (response) {
          return response.json().then(function (data) {
            return { status: response.status, data: data };
          });
        })
        .then(function (result) {
          if (result.status === 200 && result.data && result.data.ok) {
            form.hidden = true;
            successBox.hidden = false;
          } else {
            errorText.textContent =
              (result.data && result.data.error) ||
              'Une erreur est survenue. Merci de réessayer dans un instant.';
            errorBox.hidden = false;
            if (submitButton) submitButton.removeAttribute('disabled');
          }
        })
        .catch(function () {
          errorText.textContent =
            'Erreur réseau. Merci de vérifier votre connexion et réessayer.';
          errorBox.hidden = false;
          if (submitButton) submitButton.removeAttribute('disabled');
        });
    });
  })();
</script>
