---
import EditorialLabel from '../ui/EditorialLabel.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  variant?: 'default' | 'muted';
}
const { eyebrow, title, intro, variant = 'default' } = Astro.props as Props;
---

<section
  class:list={[
    'border-b border-[color:var(--color-border)]',
    variant === 'muted' && 'bg-[color:var(--color-surface-muted)]/60',
  ]}
>
  <div class="container-wide py-16 md:py-20 lg:py-24">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <EditorialLabel class="mb-5">{eyebrow}</EditorialLabel>
        <h1 class="max-w-[20ch] text-[clamp(2.25rem,5vw,4rem)] leading-[1.05] tracking-[-0.02em]">
          {title}
        </h1>
      </div>
      <div class="lg:col-span-4 lg:pt-3">
        <p class="text-[1.0625rem] leading-relaxed text-[color:var(--color-foreground-muted)] lg:border-l lg:border-[color:var(--color-border-strong)] lg:pl-6">
          {intro}
        </p>
      </div>
    </div>
  </div>
</section>
