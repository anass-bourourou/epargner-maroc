---
import type { Author } from '../../lib/articles';

interface Props {
  author?: Author;
  class?: string;
}

const { author, class: className = '' } = Astro.props as Props;
if (!author) return null;
---

<aside
  class={`flex gap-5 border-t border-[color:var(--color-border)] pt-8 ${className}`}
  aria-label="À propos de l'auteur"
>
  <div
    aria-hidden="true"
    class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-[color:var(--color-sage-100)] text-[color:var(--color-forest-800)] font-[var(--font-display)] text-[1.5rem]"
  >
    {author.data.name.charAt(0)}
  </div>
  <div>
    <p class="overline mb-1">Auteur</p>
    <p class="font-[var(--font-display)] text-[1.25rem] leading-snug text-[color:var(--color-foreground-strong)]">
      {author.data.name}
    </p>
    {author.data.role && (
      <p class="mt-0.5 text-[0.8125rem] text-[color:var(--color-foreground-muted)]">
        {author.data.role}
      </p>
    )}
    {author.data.bio && (
      <p class="mt-3 max-w-[52ch] text-[0.9375rem] leading-relaxed text-[color:var(--color-foreground)]">
        {author.data.bio}
      </p>
    )}
  </div>
</aside>
