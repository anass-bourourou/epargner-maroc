---
// -----------------------------------------------------------------------------
// Boutons de partage d'article — optimisés pour le contexte marocain.
// WhatsApp d'abord (canal principal au Maroc), LinkedIn, puis "Copier le lien".
// -----------------------------------------------------------------------------

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props as Props;

// Message pré-rempli pour WhatsApp. On garde une variante courte pour éviter
// que WhatsApp coupe. Le lien est ajouté séparément par l'API wa.me.
const whatsappText = `${title}\n\n${url}`;
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(whatsappText)}`;

// LinkedIn — partage par URL (le lecteur peut compléter le message)
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<aside class="em-share" aria-label="Partager cet article">
  <p class="em-share-label">Partager</p>
  <div class="em-share-buttons">
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="em-share-btn em-share-whatsapp"
      aria-label="Partager sur WhatsApp"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="currentColor"
      >
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.966-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.15-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
      </svg>
      <span>WhatsApp</span>
    </a>

    <a
      href={linkedinHref}
      target="_blank"
      rel="noopener noreferrer"
      class="em-share-btn em-share-linkedin"
      aria-label="Partager sur LinkedIn"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="currentColor"
      >
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
      </svg>
      <span>LinkedIn</span>
    </a>

    <button
      type="button"
      class="em-share-btn em-share-copy"
      data-copy-url={url}
      aria-label="Copier le lien"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
      </svg>
      <span class="em-copy-label">Copier le lien</span>
    </button>
  </div>
</aside>

<style>
  .em-share {
    margin: 3rem 0 0 0;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .em-share-label {
    margin: 0 0 0.75rem 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }
  .em-share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .em-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    background: var(--color-surface);
    color: var(--color-foreground-strong);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 150ms ease;
  }
  .em-share-btn:hover {
    transform: translateY(-1px);
    border-color: var(--color-primary);
  }
  .em-share-whatsapp:hover {
    background: #25d366;
    color: white;
    border-color: #25d366;
  }
  .em-share-linkedin:hover {
    background: #0a66c2;
    color: white;
    border-color: #0a66c2;
  }
  .em-share-copy:hover {
    background: var(--color-forest-500);
    color: white;
    border-color: var(--color-forest-500);
  }
  .em-share-copy.copied {
    background: var(--color-forest-500);
    color: white;
    border-color: var(--color-forest-500);
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.em-share-copy').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var url = btn.getAttribute('data-copy-url') || window.location.href;
        var label = btn.querySelector('.em-copy-label');
        var original = label ? label.textContent : 'Copier le lien';
        var reset = function () {
          if (label) label.textContent = original;
          btn.classList.remove('copied');
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () {
            if (label) label.textContent = '✓ Copié';
            btn.classList.add('copied');
            setTimeout(reset, 1800);
          });
        } else {
          // Fallback for older browsers
          var tmp = document.createElement('textarea');
          tmp.value = url;
          tmp.style.position = 'fixed';
          tmp.style.opacity = '0';
          document.body.appendChild(tmp);
          tmp.select();
          try {
            document.execCommand('copy');
            if (label) label.textContent = '✓ Copié';
            btn.classList.add('copied');
            setTimeout(reset, 1800);
          } catch (_) {}
          document.body.removeChild(tmp);
        }
      });
    });
  })();
</script>
