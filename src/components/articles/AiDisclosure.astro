---
// -----------------------------------------------------------------------------
// AI disclosure — discret, positionné en bas d'article avant les sources.
// Signal de qualité (score + revue) plutôt qu'avertissement anxiogène.
// -----------------------------------------------------------------------------

interface Props {
  score?: number;
}

const { score } = Astro.props as Props;
---

<aside class="em-ai-note" aria-label="Note éditoriale">
  <p class="em-ai-note-body">
    <span class="em-ai-icon" aria-hidden="true">✎</span>
    <span>
      Article rédigé avec assistance IA et relu par notre système éditorial
      {score !== undefined && (
        <>
          — <strong>score qualité {score}/100</strong>
        </>
      )}. Comme pour tout contenu financier, vérifiez les données spécifiques
      auprès de sources officielles avant toute décision engageante.
      <a href="mailto:hello@epargner-maroc.com" class="em-ai-report"
        >Signaler une erreur</a
      >.
    </span>
  </p>
</aside>

<style>
  .em-ai-note {
    margin: 3rem 0 0 0;
    padding: 1rem 1.25rem;
    background: var(--color-surface-muted);
    border-left: 3px solid var(--color-sage-300);
    border-radius: 0.25rem;
  }
  .em-ai-note-body {
    margin: 0;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-foreground-muted);
    font-style: italic;
  }
  .em-ai-icon {
    flex-shrink: 0;
    color: var(--color-sage-300);
    font-size: 1rem;
    line-height: 1;
    padding-top: 2px;
  }
  .em-ai-report {
    color: var(--color-foreground-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .em-ai-report:hover {
    color: var(--color-primary);
  }
</style>
