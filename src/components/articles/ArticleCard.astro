---
import EditorialLabel from '../ui/EditorialLabel.astro';
import Icon from '../ui/Icon.astro';

type Variant = 'featured' | 'standard' | 'compact';

interface Props {
  variant?: Variant;
  href: string;
  category?: string;
  categoryHref?: string;
  title: string;
  description?: string;
  date?: string; // pre-formatted, e.g. "18 août 2026"
  readingMinutes?: number;
  imageSrc?: string;
  imageAlt?: string;
  class?: string;
}

const {
  variant = 'standard' as Variant,
  href,
  category,
  categoryHref,
  title,
  description,
  date,
  readingMinutes,
  imageSrc,
  imageAlt = '',
  class: className = '',
} = Astro.props as Props;
---

{
  variant === 'featured' && (
    <article class={`group grid gap-6 md:grid-cols-2 md:gap-10 ${className}`}>
      {imageSrc && (
        <a href={href} class="block overflow-hidden no-underline" aria-hidden="true" tabindex="-1">
          <img
            src={imageSrc}
            alt={imageAlt}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        </a>
      )}
      <div class="flex flex-col justify-center">
        {category && (
          <EditorialLabel href={categoryHref} class="mb-3">{category}</EditorialLabel>
        )}
        <h2 class="text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.1]">
          <a href={href} class="no-underline decoration-transparent transition-colors hover:text-[color:var(--color-primary)]">
            {title}
          </a>
        </h2>
        {description && (
          <p class="mt-4 text-[1.0625rem] leading-relaxed text-[color:var(--color-foreground-muted)] max-w-[52ch]">
            {description}
          </p>
        )}
        <div class="mt-5 flex items-center gap-3 text-[0.8125rem] text-[color:var(--color-foreground-subtle)]">
          {date && <time>{date}</time>}
          {date && readingMinutes && <span aria-hidden="true">·</span>}
          {readingMinutes && (
            <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={13} /> {readingMinutes} min</span>
          )}
        </div>
      </div>
    </article>
  )
}

{
  variant === 'standard' && (
    <article class={`group flex flex-col ${className}`}>
      {imageSrc && (
        <a href={href} class="block overflow-hidden no-underline mb-5" aria-hidden="true" tabindex="-1">
          <img
            src={imageSrc}
            alt={imageAlt}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        </a>
      )}
      {category && (
        <EditorialLabel href={categoryHref} class="mb-2">{category}</EditorialLabel>
      )}
      <h3 class="text-[1.375rem] leading-[1.2]">
        <a href={href} class="no-underline decoration-transparent transition-colors hover:text-[color:var(--color-primary)]">
          {title}
        </a>
      </h3>
      {description && (
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-[color:var(--color-foreground-muted)]">
          {description}
        </p>
      )}
      <div class="mt-4 flex items-center gap-3 text-[0.8125rem] text-[color:var(--color-foreground-subtle)]">
        {date && <time>{date}</time>}
        {date && readingMinutes && <span aria-hidden="true">·</span>}
        {readingMinutes && <span>{readingMinutes} min</span>}
      </div>
    </article>
  )
}

{
  variant === 'compact' && (
    <article class={`group flex gap-4 py-4 border-b border-[color:var(--color-border)] last:border-b-0 ${className}`}>
      <div class="min-w-0 flex-1">
        {category && (
          <EditorialLabel href={categoryHref} class="mb-1.5">{category}</EditorialLabel>
        )}
        <h4 class="text-[1rem] leading-[1.3] font-[var(--font-display)] font-medium">
          <a href={href} class="no-underline decoration-transparent transition-colors hover:text-[color:var(--color-primary)]">
            {title}
          </a>
        </h4>
        {(date || readingMinutes) && (
          <div class="mt-1.5 flex items-center gap-2 text-[0.75rem] text-[color:var(--color-foreground-subtle)]">
            {date && <time>{date}</time>}
            {date && readingMinutes && <span aria-hidden="true">·</span>}
            {readingMinutes && <span>{readingMinutes} min</span>}
          </div>
        )}
      </div>
      {imageSrc && (
        <a href={href} aria-hidden="true" tabindex="-1" class="shrink-0 overflow-hidden">
          <img
            src={imageSrc}
            alt={imageAlt}
            loading="lazy"
            decoding="async"
            class="h-20 w-20 object-cover sm:h-24 sm:w-24"
          />
        </a>
      )}
    </article>
  )
}
