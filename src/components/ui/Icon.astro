---
import { ICONS, type IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  title?: string;
  'aria-hidden'?: boolean;
}

const {
  name,
  size = 20,
  strokeWidth = 1.5,
  class: className,
  title,
  'aria-hidden': ariaHidden = title ? false : true,
} = Astro.props as Props;

const path = ICONS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaHidden ? 'true' : undefined}
  role={title ? 'img' : undefined}
  focusable="false"
  set:html={(title ? `<title>${title}</title>` : '') + path}
/>
