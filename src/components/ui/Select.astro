---
import Icon from './Icon.astro';

interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name?: string;
  label: string;
  options: Option[];
  value?: string;
  helper?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  placeholder?: string;
}

const {
  id,
  name = id,
  label,
  options,
  value,
  helper,
  error,
  required = false,
  disabled = false,
  placeholder,
} = Astro.props as Props;

const helperId = helper ? `${id}-helper` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [helperId, errorId].filter(Boolean).join(' ') || undefined;

const selectBase =
  'w-full h-11 bg-[color:var(--color-surface)] text-[color:var(--color-foreground-strong)] ' +
  'border rounded-[var(--radius-sm)] pl-3 pr-10 text-[0.9375rem] appearance-none ' +
  'transition-colors duration-[var(--duration-fast)] ease-[var(--ease-standard)] ' +
  'focus:outline-none focus:border-[color:var(--color-primary)] focus:ring-2 focus:ring-[color:var(--color-forest-500)]/25 ' +
  'disabled:bg-[color:var(--color-surface-muted)] disabled:text-[color:var(--color-foreground-subtle)] disabled:cursor-not-allowed';

const borderColor = error
  ? 'border-[color:var(--color-terracotta-700)]'
  : 'border-[color:var(--color-border-strong)]';
---

<div class="flex flex-col gap-1.5">
  <label
    for={id}
    class="text-[0.875rem] font-medium text-[color:var(--color-foreground-strong)]"
  >
    {label}{required && <span aria-hidden="true" class="text-[color:var(--color-terracotta-700)]"> *</span>}
  </label>
  <div class="relative">
    <select
      id={id}
      name={name}
      required={required || undefined}
      disabled={disabled || undefined}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      class={`${selectBase} ${borderColor}`}
    >
      {placeholder && (
        <option value="" disabled selected={!value}>{placeholder}</option>
      )}
      {options.map((opt) => (
        <option value={opt.value} selected={opt.value === value}>{opt.label}</option>
      ))}
    </select>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-[color:var(--color-foreground-muted)]"
    >
      <Icon name="chevron-down" size={16} />
    </span>
  </div>
  {helper && !error && (
    <p id={helperId} class="text-[0.8125rem] text-[color:var(--color-foreground-muted)]">
      {helper}
    </p>
  )}
  {error && (
    <p id={errorId} class="text-[0.8125rem] text-[color:var(--color-terracotta-700)]">
      {error}
    </p>
  )}
</div>
