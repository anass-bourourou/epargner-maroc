---
interface Props {
  id: string;
  name?: string;
  label: string;
  type?: 'text' | 'email' | 'number' | 'search' | 'tel' | 'url' | 'password';
  value?: string | number;
  placeholder?: string;
  helper?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  min?: number;
  max?: number;
  step?: number;
  inputmode?: 'text' | 'numeric' | 'decimal' | 'email' | 'search' | 'tel' | 'url';
  suffix?: string;
  autocomplete?: string;
}

const {
  id,
  name = id,
  label,
  type = 'text',
  value,
  placeholder,
  helper,
  error,
  required = false,
  disabled = false,
  min,
  max,
  step,
  inputmode,
  suffix,
  autocomplete,
} = Astro.props as Props;

const helperId = helper ? `${id}-helper` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [helperId, errorId].filter(Boolean).join(' ') || undefined;

const inputBase =
  'w-full h-11 bg-[color:var(--color-surface)] text-[color:var(--color-foreground-strong)] ' +
  'border rounded-[var(--radius-sm)] px-3 text-[0.9375rem] ' +
  'placeholder:text-[color:var(--color-foreground-subtle)] ' +
  'transition-colors duration-[var(--duration-fast)] ease-[var(--ease-standard)] ' +
  'focus:outline-none focus:border-[color:var(--color-primary)] focus:ring-2 focus:ring-[color:var(--color-forest-500)]/25 ' +
  'disabled:bg-[color:var(--color-surface-muted)] disabled:text-[color:var(--color-foreground-subtle)] disabled:cursor-not-allowed';

const borderColor = error
  ? 'border-[color:var(--color-terracotta-700)]'
  : 'border-[color:var(--color-border-strong)]';
---

<div class="flex flex-col gap-1.5">
  <label
    for={id}
    class="text-[0.875rem] font-medium text-[color:var(--color-foreground-strong)]"
  >
    {label}{required && <span aria-hidden="true" class="text-[color:var(--color-terracotta-700)]"> *</span>}
  </label>
  <div class="relative">
    <input
      id={id}
      name={name}
      type={type}
      value={value !== undefined ? String(value) : undefined}
      placeholder={placeholder}
      required={required || undefined}
      disabled={disabled || undefined}
      min={min}
      max={max}
      step={step}
      inputmode={inputmode}
      autocomplete={autocomplete}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      class={`${inputBase} ${borderColor} ${suffix ? 'pr-14' : ''} num`}
    />
    {suffix && (
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-[0.875rem] text-[color:var(--color-foreground-muted)]"
      >
        {suffix}
      </span>
    )}
  </div>
  {helper && !error && (
    <p id={helperId} class="text-[0.8125rem] text-[color:var(--color-foreground-muted)]">
      {helper}
    </p>
  )}
  {error && (
    <p id={errorId} class="text-[0.8125rem] text-[color:var(--color-terracotta-700)]">
      {error}
    </p>
  )}
</div>
