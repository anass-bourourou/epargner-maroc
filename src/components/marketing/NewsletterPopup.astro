---
// -----------------------------------------------------------------------------
// Popup newsletter intelligent — apparaît discrètement en bas à droite après
// 30 secondes de lecture OU 50% de scroll (le premier des deux).
// Se souvient de la fermeture via localStorage (30 jours de silence).
// Utilise le même backend Cloudflare Worker que le formulaire principal.
// -----------------------------------------------------------------------------

const WORKER_URL =
  'https://newsletter-epargner-maroc.anassbr01.workers.dev/';
---

<div
  id="em-newsletter-popup"
  class="em-popup"
  hidden
  role="dialog"
  aria-labelledby="em-popup-title"
  aria-describedby="em-popup-desc"
>
  <button
    type="button"
    id="em-popup-close"
    class="em-popup-close"
    aria-label="Fermer"
  >
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
    >
      <path d="M18 6L6 18M6 6l12 12"></path>
    </svg>
  </button>

  <div id="em-popup-form-view">
    <p class="em-popup-eyebrow">Newsletter</p>
    <h3 id="em-popup-title" class="em-popup-title">
      Un e-mail par semaine, rien de plus.
    </h3>
    <p id="em-popup-desc" class="em-popup-desc">
      Une lecture, un outil, un chiffre à retenir. Sans pub, sans affiliation
      bancaire.
    </p>

    <form id="em-popup-form" class="em-popup-form" novalidate>
      <input
        type="email"
        name="email"
        placeholder="vous@exemple.ma"
        autocomplete="email"
        required
        class="em-popup-input"
        aria-label="Votre e-mail"
      />
      <button type="submit" class="em-popup-submit">Je m'inscris</button>
    </form>

    <p id="em-popup-error" class="em-popup-error" hidden></p>
  </div>

  <div id="em-popup-success-view" hidden class="em-popup-success">
    <p class="em-popup-success-title">✅ Merci — inscription confirmée.</p>
    <p class="em-popup-success-text">
      Vous recevrez notre prochaine lettre vendredi.
    </p>
  </div>
</div>

<style>
  .em-popup {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 100;
    max-width: 22rem;
    width: calc(100vw - 2.5rem);
    padding: 1.5rem;
    background: var(--color-forest-900);
    color: var(--color-ivory-50);
    border-radius: 0.75rem;
    box-shadow:
      0 20px 40px -12px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.05);
    animation: em-popup-in 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes em-popup-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .em-popup-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    background: transparent;
    color: var(--color-sage-300);
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
  }
  .em-popup-close:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-ivory-50);
  }

  .em-popup-eyebrow {
    margin: 0 0 0.5rem 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-sage-300);
  }
  .em-popup-title {
    margin: 0;
    font-family: var(--font-serif, 'Playfair Display', Georgia, serif);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--color-ivory-50);
  }
  .em-popup-desc {
    margin: 0.5rem 0 1rem 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-sage-300);
  }

  .em-popup-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
  }
  .em-popup-input {
    width: 100%;
    height: 2.5rem;
    padding: 0 0.75rem;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-ivory-50);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .em-popup-input::placeholder {
    color: var(--color-sage-500);
  }
  .em-popup-input:focus {
    outline: none;
    border-color: var(--color-sage-300);
    box-shadow: 0 0 0 3px rgba(193, 207, 196, 0.18);
  }

  .em-popup-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    padding: 0 1rem;
    background: var(--color-forest-500);
    color: var(--color-ivory-50);
    border: 1px solid var(--color-forest-500);
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .em-popup-submit:hover {
    background: var(--color-forest-700, #143128);
  }
  .em-popup-submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .em-popup-error {
    margin: 0.75rem 0 0 0;
    font-size: 0.8125rem;
    color: #ffb4a2;
  }

  .em-popup-success-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ivory-50);
  }
  .em-popup-success-text {
    margin: 0.25rem 0 0 0;
    font-size: 0.875rem;
    color: var(--color-sage-300);
  }

  @media (max-width: 480px) {
    .em-popup {
      right: 0.75rem;
      bottom: 0.75rem;
      left: 0.75rem;
      width: auto;
      max-width: none;
    }
  }
</style>

<script is:inline define:vars={{ WORKER_URL }}>
  (function () {
    var STORAGE_KEY = 'em_newsletter_popup_dismissed_v1';
    var DISMISS_DURATION_MS = 30 * 24 * 60 * 60 * 1000; // 30 jours
    var TIME_TRIGGER_MS = 30 * 1000; // 30 secondes
    var SCROLL_TRIGGER_PCT = 50; // 50% scroll

    var popup = document.getElementById('em-newsletter-popup');
    var closeBtn = document.getElementById('em-popup-close');
    var form = document.getElementById('em-popup-form');
    var formView = document.getElementById('em-popup-form-view');
    var successView = document.getElementById('em-popup-success-view');
    var errorBox = document.getElementById('em-popup-error');

    if (!popup || !closeBtn || !form || !formView || !successView || !errorBox) {
      return;
    }

    // Cas 1 : déjà fermé récemment → ne rien faire
    try {
      var dismissedAt = window.localStorage.getItem(STORAGE_KEY);
      if (dismissedAt) {
        var elapsed = Date.now() - parseInt(dismissedAt, 10);
        if (!isNaN(elapsed) && elapsed < DISMISS_DURATION_MS) {
          return;
        }
      }
    } catch (_) {
      // localStorage indisponible (navigation privée stricte) → on continue quand même
    }

    var shown = false;

    function show() {
      if (shown) return;
      shown = true;
      popup.hidden = false;
    }

    function dismiss() {
      popup.hidden = true;
      try {
        window.localStorage.setItem(STORAGE_KEY, String(Date.now()));
      } catch (_) {}
    }

    // Trigger temps : 30 sec
    var timeTrigger = window.setTimeout(show, TIME_TRIGGER_MS);

    // Trigger scroll : 50%
    function onScroll() {
      if (shown) {
        window.removeEventListener('scroll', onScroll);
        return;
      }
      var doc = document.documentElement;
      var scrollTop = doc.scrollTop || document.body.scrollTop;
      var scrollHeight = doc.scrollHeight - doc.clientHeight;
      if (scrollHeight <= 0) return;
      var pct = (scrollTop / scrollHeight) * 100;
      if (pct >= SCROLL_TRIGGER_PCT) {
        clearTimeout(timeTrigger);
        show();
        window.removeEventListener('scroll', onScroll);
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });

    closeBtn.addEventListener('click', dismiss);

    // ESC key to close
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !popup.hidden) dismiss();
    });

    // Submit → Worker
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var input = form.querySelector('input[type="email"]');
      var email = input ? String(input.value || '').trim() : '';
      if (!email) return;

      var button = form.querySelector('button[type="submit"]');
      if (button) button.setAttribute('disabled', 'disabled');
      errorBox.hidden = true;

      fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email }),
      })
        .then(function (r) {
          return r.json().then(function (data) {
            return { status: r.status, data: data };
          });
        })
        .then(function (result) {
          if (result.status === 200 && result.data && result.data.ok) {
            formView.hidden = true;
            successView.hidden = false;
            try {
              window.localStorage.setItem(STORAGE_KEY, String(Date.now()));
            } catch (_) {}
            // Auto-fermer après 4 sec
            window.setTimeout(function () {
              popup.hidden = true;
            }, 4000);
          } else {
            errorBox.textContent =
              (result.data && result.data.error) ||
              'Une erreur est survenue. Merci de réessayer.';
            errorBox.hidden = false;
            if (button) button.removeAttribute('disabled');
          }
        })
        .catch(function () {
          errorBox.textContent =
            'Erreur réseau. Merci de vérifier votre connexion.';
          errorBox.hidden = false;
          if (button) button.removeAttribute('disabled');
        });
    });
  })();
</script>
