# -----------------------------------------------------------------------------
# Épargner Maroc — Environment template
# Copy to `.env` for local dev, or configure in your host's dashboard for prod.
# -----------------------------------------------------------------------------

# ---- Site ------------------------------------------------------------------
# Public origin used by Astro for canonical URLs, sitemap, RSS, OG links.
SITE_URL="https://epargnermaroc.ma"

# ---- Newsletter (Phase 9+) --------------------------------------------------
# Provider connection for the newsletter form.
# NEWSLETTER_PROVIDER=""   # e.g. "mailerlite" | "brevo" | "resend"
# NEWSLETTER_API_KEY=""
# NEWSLETTER_LIST_ID=""

# ---- Analytics (optional, privacy-first) ------------------------------------
# Only generic events (calculator_opened, calculator_completed).
# Never store salary, loan amount, expenses, savings amount.
# PLAUSIBLE_DOMAIN=""
# UMAMI_WEBSITE_ID=""

# ---- Contact / security -----------------------------------------------------
# Address referenced by /.well-known/security.txt
SECURITY_CONTACT_EMAIL="security@epargnermaroc.ma"
